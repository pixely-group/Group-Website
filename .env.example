# ——— Auth — sign in with Google and Apple ————————————————————
# Copy to .env.local (dev) or set in the host's environment (prod).
# A connector activates the moment its variables exist; until then its
# button explains that it is not connected yet.

# The site's canonical origin. Needed behind any proxy/CDN, since the
# request's own host is the proxy's. e.g. https://www.pixely.com
AUTH_URL=

# Session cookie signing secret:  openssl rand -base64 32
# Unset, a per-boot secret is generated and sessions die on restart.
AUTH_SECRET=

# Google — console.cloud.google.com → APIs & Services → Credentials
#   OAuth client type: Web application
#   Authorised redirect URIs:
#     http://localhost:3000/api/auth/google/callback   (dev)
#     https://<your-domain>/api/auth/google/callback   (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple — developer.apple.com → Certificates, Identifiers & Profiles
#   APPLE_CLIENT_ID is the *Services ID* (not the App ID), with
#   "Sign in with Apple" enabled and the return URL registered:
#     https://<your-domain>/api/auth/apple/callback
#   Apple refuses plain http://localhost — dev needs an https tunnel.
#   APPLE_PRIVATE_KEY is the .p8 file's full text; \n for newlines is fine.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ——— Email verifier extras ————————————————————————————————
# The SMTP mailbox probe (off unless the host can reach port 25 outbound —
# almost no cloud host can; see src/lib/smtp-probe.ts).
SMTP_PROBE=
SMTP_PROBE_HELO=
SMTP_PROBE_FROM=

# ——— Brevo waitlist (server only; never use NEXT_PUBLIC_) ———
BREVO_API_KEY=
# Numeric ID of the Pixely waitlist contact list.
BREVO_WAITLIST_LIST_ID=
# Must be an active, verified Brevo sender (SMTP login is not necessarily a sender).
BREVO_SENDER_EMAIL=
# Create a boolean contact attribute named PIXELY_WAITLIST_CONFIRMED in Brevo.
