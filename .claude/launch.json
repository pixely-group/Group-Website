{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/preview-dev.mjs"
      ],
      "port": 3000,
      "autoPort": true,
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    },
    {
      "name": "wordpress-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3101",
        "--directory",
        "wordpress"
      ],
      "port": 3101
    }
  ]
}
